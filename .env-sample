## individual-stage mode ##

# STAGE_TYPE="" # governor | queue-governor | nominee-governor | timelock | outbox | retryable
# STAGE_ADDRESS="" # the contract the stage acts on (governor, timelock, outbox, or bridge)
# START_BLOCK="" # scan for events from this block, on the chain findEvents runs on

# governor / queue-governor / nominee-governor / timelock: chain the contract lives on
# RPC_URL=""

# outbox: finds L2ToL1Tx on the L2, executes on the L1 outbox (STAGE_ADDRESS)
# L2_RPC_URL=""
# L1_RPC_URL=""
# L2_CALLER="" # e.g. the L2 timelock
# L1_DESTINATION="" # e.g. the L1 timelock

# retryable: finds executions on the L1, redeems tickets on the L2
# L1_RPC_URL=""
# L2_RPC_URL=""
# L1_TIMELOCK=""
# L1_UPGRADE_EXECUTOR=""

# optional: pinged after each fully successful iteration
# PROPMON_HEALTHCHECK_URL=""

# optional tuning (defaults shown)
# POLL_INTERVAL_SECONDS="60"
# GETLOGS_WAIT_SECONDS="5"
# RPC_RETRY_COUNT="5"
# RPC_RETRY_INTERVAL_SECONDS="5"
# LOG_LEVEL="info" # debug | info | warn
