# key used to send executing txs on all chains
PROPMON_PRIVATE_KEY=""

# stages are defined in a jsonc config file (default: full Arbitrum DAO governance)
# PROPMON_CONFIG="config/arb1-governance.jsonc"

# rpc urls referenced by the config's chains (via rpcUrlEnv)
ETH_RPC_URL=""
ARB_RPC_URL=""
NOVA_RPC_URL=""

# optional: pinged after each fully successful iteration
# PROPMON_HEALTHCHECK_URL=""

# optional tuning (defaults shown)
# POLL_INTERVAL_SECONDS="60"
# GETLOGS_WAIT_SECONDS="5"
# RPC_RETRY_COUNT="5"
# RPC_RETRY_INTERVAL_SECONDS="5"
# LOG_LEVEL="info" # debug | info | warn
