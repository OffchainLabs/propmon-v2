# PROPMON_MODE="arb-full-governance" # arb-full-governance (default) | individual-stage

## arb-full-governance mode ##

ETH_RPC_URL=""
ARB_RPC_URL=""
NOVA_RPC_URL=""

# scan for events from these blocks
ARB_START_BLOCK=""
ETH_START_BLOCK=""

